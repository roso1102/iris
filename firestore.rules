rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tenant-scoped paths only. The JWT custom claim tenant_id must match
    // BOTH the path segment AND the document's tenant_id field.
    match /tenants/{tenant_id}/{document=**} {
      allow read: if request.auth != null
        && request.auth.token.tenant_id == tenant_id
        && request.auth.token.tenant_id == resource.data.tenant_id;
      allow create, update: if request.auth != null
        && request.auth.token.tenant_id == tenant_id
        && request.auth.token.tenant_id == request.resource.data.tenant_id;
      allow delete: if request.auth != null
        && request.auth.token.tenant_id == tenant_id
        && request.auth.token.tenant_id == resource.data.tenant_id;
    }

    // Server-side only (worker writes with Admin SDK, which bypasses rules).
    // Clients may read their own ingestion progress but never write it.
    match /ingestion_progress/{tenant_id}/documents/{doc_id} {
      allow read: if request.auth != null
        && request.auth.token.tenant_id == tenant_id;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
